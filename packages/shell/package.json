{
  "name": "@novi/shell",
  "version": "0.0.0",
  "private": true,
  "description": "App shell: launcher, menus, command palette, breadcrumbs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@novi/engine": "workspace:*",
    "@novi/odoo-meta": "workspace:*",
    "@novi/ui": "workspace:*",
    "@novi/views": "workspace:*",
    "lucide-react": "^0.468.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@novi/odoo-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.62.0"
  },
  "sideEffects": false
}
