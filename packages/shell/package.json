{
  "name": "@novi/shell",
  "version": "0.0.0",
  "private": true,
  "description": "App shell: launcher, menus, command palette, breadcrumbs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@novi/engine": "workspace:*",
    "@novi/ui": "workspace:*"
  }
}
