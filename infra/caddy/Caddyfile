# NOVI edge (P1.5.6): TLS for every tenant host, then everything goes to the gateway, which does
# all routing (tenant from the Host header, D-27). Stock Caddy, no plugins, no DNS credentials:
# certificates are issued on demand for hosts the gateway confirms (active tenants, the platform
# host, and later customers' own domains).
#
#   production: point *.novi.app (and custom domains) at the server; leave CADDY_LOCAL_CERTS empty
#   locally:    pnpm edge  → https://acme.localhost:8443 with Caddy's own local CA
{
	{$CADDY_LOCAL_CERTS}
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
	on_demand_tls {
		ask http://{$GATEWAY:127.0.0.1:8080}/api/tls/allowed
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	# Host, X-Forwarded-For and X-Forwarded-Proto=https are passed on; websockets work as is
	reverse_proxy {$GATEWAY:127.0.0.1:8080}
}
