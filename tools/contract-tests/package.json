{
  "name": "@novi/contract-tests",
  "version": "0.0.0",
  "private": true,
  "description": "API contract suite against a stock Odoo 20 (pnpm odoo:up && pnpm odoo:seed first)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:update": "vitest run -u",
