    "capture-specs": "node scripts/capture-client-specs.mjs"
  },
  "dependencies": {
    "@novi/engine": "workspace:*",
    "@novi/gateway": "workspace:*",
    "@novi/odoo-client": "workspace:*",
    "@novi/odoo-expr": "workspace:*",
    "@novi/odoo-meta": "workspace:*",
    "@novi/provisioner": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "ws": "^8.18.0"
  }
}
