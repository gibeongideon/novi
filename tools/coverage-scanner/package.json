{
  "name": "@novi/coverage-scanner",
  "version": "0.0.0",
  "private": true,
  "description": "Scans every action/view of an Odoo DB and reports what the NOVI engine supports natively",
  "type": "module",
  "bin": {
    "novi-scan": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "scan": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@novi/odoo-client": "workspace:*"
  }
}
