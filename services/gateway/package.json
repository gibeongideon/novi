{
  "name": "@novi/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "NOVI gateway (BFF): tenant routing, auth bridge, RPC proxy",
  "type": "module",
  "dependencies": {
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/reply-from": "^12.0.0",
    "@fastify/static": "^8.0.0",
    "@novi/odoo-client": "workspace:*",
    "fastify": "^5.2.0",
    "@novi/provisioner": "workspace:*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
