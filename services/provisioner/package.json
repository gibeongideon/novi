{
  "name": "@novi/provisioner",
  "version": "0.0.0",
  "private": true,
  "description": "NOVI provisioner: tenant lifecycle jobs (create, install apps, suspend, backup, delete)",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  }
}
