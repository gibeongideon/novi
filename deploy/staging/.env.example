# Copy to /opt/novi/.env on the server (never commit the real file).
#
# Generate the password hash ON THE SERVER:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the hash in SINGLE quotes so the $ signs are taken literally.

NOVI_AUTH_USER=novi
NOVI_AUTH_HASH='CHANGE_ME'
