# NOVI internal proxy. Plain HTTP only: dafeapp's Caddy terminates TLS for novi.dafeapp.com
# and forwards here over the "edge" network.
{
	auto_https off
}

:80 {
	# Staging is private: one shared login for the whole site.
	# Credentials come from /opt/novi/.env (NOVI_AUTH_USER / NOVI_AUTH_HASH).
	basic_auth {
		{$NOVI_AUTH_USER} {$NOVI_AUTH_HASH}
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Progress dashboard (generated from TASKS.md on every push to main)
	handle_path /progress* {
		root * /srv/progress
		file_server
	}

	# Until the app exists (P1), the root goes to the dashboard.
	handle {
		redir * /progress/ 302
	}

	encode gzip
}
